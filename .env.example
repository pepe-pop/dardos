# ============================================================
# Skopiuj ten plik do .env i uzupełnij wartościami.
# Plik .env jest IGNOROWANY przez gita — nie trafi do GitHub.
# W GitHub ustaw te same wartości jako sekrety (repo → Settings →
# Secrets and variables → Actions), a workflow wgra je do buildu.
# ============================================================

# 🔐 Hasło wejścia do aplikacji dla uczestników (inne niż klucz admina)
VITE_APP_PASSWORD=tajne-haslo-zjazdu

# 🔐 Klucz panelu organizatora (#/admin)
VITE_ADMIN_KEY=tajny-klucz-admina

# Firebase (opcjonalnie — tylko gdy włączasz tryb produkcji 'firebase')
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
