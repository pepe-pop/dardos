rules_version = '2';

// ============================================================
// REGUŁY FIRESTORE — aplikacja zjazdowa „10 lat klubu darta"
// Wgranie: firebase deploy --only firestore:rules
// (lub w konsoli Firebase → Firestore → Reguły)
// ============================================================

// Sekret administratora — ZMIEŃ na długi losowy ciąg (ten sam co w src/config.js, FEATURES.adminKey)
// Uwaga: reguły nie są widoczne dla użytkowników aplikacji, ale są widoczne w konsoli projektu.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- ZDJĘCIA ----------
    // Odczyt: publiczny. Tworzenie: każdy może dodać (bez moderacji — zdjęcie
    // od razu w galerii, w folderze podanym przez klienta). Zmiany/usuwanie:
    // tylko admin (przenoszenie między folderami, zmiana roku, usuwanie).
    match /zdjecia/{id} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasOnly(['author', 'caption', 'year', 'folder', 'src', 'thumb', 'at'])
        && request.resource.data.author is string
        && request.resource.data.author.size() >= 2
        && request.resource.data.author.size() <= 40
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 140
        && request.resource.data.year is string
        && request.resource.data.folder is string
        && request.resource.data.folder.size() >= 2
        && request.resource.data.folder.size() <= 60
        && request.resource.data.src is string;
      allow update, delete: if isAdmin(request);
    }

    // ---------- ZDANIA (gra „Kto to powiedział?") ----------
    match /zdania/{id} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasOnly(['author', 'text', 'deviceId', 'status', 'at'])
        && request.resource.data.status == 'pending'
        && request.resource.data.author is string
        && request.resource.data.author.size() >= 2
        && request.resource.data.author.size() <= 30
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 10
        && request.resource.data.text.size() <= 160;
      allow update, delete: if isAdmin(request);
    }

    // ---------- WYNIKI ----------
    match /wyniki/{id} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasOnly(['game', 'author', 'score', 'max', 'timeMs', 'at'])
        && request.resource.data.author is string
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 1000;
      allow update, delete: if isAdmin(request);
    }

    // ---------- UCZESTNICY (licznik) ----------
    match /uczestnicy/{deviceId} {
      allow read: if true;
      // jeden dokument na urządzenie (klucz = deviceId) — naturalna ochrona przed spamem
      allow create: if request.resource.data.keys().hasOnly(['name', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40;
      allow update: if request.resource.data.diff().affectedKeys().hasOnly(['name']);
      allow delete: if isAdmin(request);
    }

    // ---------- USTAWIENIA (status gry itp.) ----------
    match /ustawienia/{doc} {
      allow read: if true;
      allow write: if isAdmin(request);
    }

    // Sekret admina — porównanie jawnym ciągiem (wystarczające na 1-dniowe wydarzenie;
    // mocniejszy wariant: weryfikacja przez Cloud Function — patrz KONCEPCJA.md)
    function isAdmin(request) {
      return request.resource.data.adminKey == 'DZISIEJSZY-TAJNY-KLUCZ-ZMIEN-MNIE';
    }
  }
}
