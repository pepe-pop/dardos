rules_version = '2';

// ============================================================
// REGUŁY FIRESTORE — aplikacja zjazdowa „10 lat klubu darta"
// Wgranie: Firestore → zakładka „Rules" → wklej → „Publikuj".
// ⚠️ PO ZMIANIE REGUŁ MUSISZ JE PONOWNIE WRZUCIĆ W KONSOLI FIREBASE!
// ============================================================
//
// MODEL BEZPIECZEŃSTWA (świadomy kompromis dla wydarzenia):
// - odczyt: publiczny (aplikacja jest "otwarta" przez QR),
// - tworzenie: każdy, ale z walidacją pól (rozmiary, dozwolony zestaw pól),
// - aktualizacja/usuwanie: ograniczone DO KONKRETNYCH PÓL (nie da się podmienić
//   zdjęcia czy tekstu przez update), a pełne "porządkowanie" (foldery, statusy)
//   robi się z panelu organizatora — panel jest chroniony kluczem w UI.
// To jest "miękka ochrona" (bez kont) — pełne bezpieczeństwo wymagałoby
// Firebase Auth, co wykracza poza budżet 0 zł wydarzenia.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- ZDJĘCIA I FILMY ----------
    // create: każdy może dodać, ale DOKŁADNIE pola:
    //   author, caption, year, folder, src, thumb, poster, type, at.
    //   type: 'image' | 'video' (film ma dodatkowo poster = miniaturkę).
    // update: tylko porządkowanie (year, folder, caption, author) — nie da się podmienić src/poster.
    // delete: dozwolone (usuwanie z panelu organizatora).
    match /zdjecia/{id} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasOnly(['author', 'caption', 'year', 'folder', 'src', 'thumb', 'poster', 'type', 'at'])
        && request.resource.data.author is string
        && request.resource.data.author.size() >= 2
        && request.resource.data.author.size() <= 40
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 140
        && request.resource.data.year is string
        && request.resource.data.year.size() <= 4
        && request.resource.data.folder is string
        && request.resource.data.folder.size() >= 2
        && request.resource.data.folder.size() <= 60
        && request.resource.data.type is string
        && request.resource.data.type in ['image', 'video']
        && request.resource.data.src is string;
      allow update: if
        request.resource.data.diff().affectedKeys().hasOnly(['year', 'folder', 'caption', 'author']);
      allow delete: if true;
    }

    // ---------- ZDANIA (gra „Kto to powiedział?") ----------
    // create: dokładnie pola author, text, deviceId, round, status, at.
    // update: TYLKO zmiana statusu (akceptacja/odrzucenie przez organizatora).
    // delete: dozwolone (usuwanie z panelu organizatora).
    match /zdania/{id} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasOnly(['author', 'text', 'deviceId', 'round', 'status', 'at'])
        && request.resource.data.author is string
        && request.resource.data.author.size() >= 2
        && request.resource.data.author.size() <= 30
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 10
        && request.resource.data.text.size() <= 160
        && request.resource.data.round is int
        && request.resource.data.round >= 1
        && request.resource.data.status == 'pending';
      allow update: if
        request.resource.data.diff().affectedKeys().hasOnly(['status']);
      allow delete: if true;
    }

    // ---------- WYNIKI ----------
    match /wyniki/{id} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasOnly(['game', 'author', 'score', 'max', 'timeMs', 'at'])
        && request.resource.data.author is string
        && request.resource.data.author.size() <= 40
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 1000;
      allow update, delete: if true;
    }

    // ---------- UCZESTNICY (licznik) ----------
    // jeden dokument na urządzenie (klucz = deviceId) — naturalna ochrona przed spamem
    match /uczestnicy/{deviceId} {
      allow read: if true;
      allow create, update: if
        request.resource.data.keys().hasOnly(['name', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40;
      allow delete: if true;
    }

    // ---------- USTAWIENIA (status gry, runda, minSentences) ----------
    // Tylko nieszkodliwa konfiguracja gry — zapis dozwolony (zmienia ją panel organizatora).
    match /ustawienia/{doc} {
      allow read: if true;
      allow write: if true;
    }
  }
}
